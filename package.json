{
  "name": "sensei-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sensei-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply sensei-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@tanstack/react-router": "^1.158.4",
    "@tanstack/react-start": "^1.159.0",
    "drizzle-orm": "^0.38.0",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.463.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.0.0"
  }
}
