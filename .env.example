# Google OAuth (from GCP Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Anthropic (from console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Session secret (generate: openssl rand -base64 32)
SESSION_SECRET=your-session-secret

# Cloudflare D1 (from Cloudflare Dashboard > Workers & Pages > D1)
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
